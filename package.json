{
  "name": "qixiaoguang-tools",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "node scripts/sync-fonts.mjs && next dev",
    "build": "node scripts/sync-fonts.mjs && next build && node scripts/verify-output.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:preview": "pnpm build && wrangler preview"
  },
  "dependencies": {
    "mdui": "^2.1.5",
    "next": "^16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@fontsource/cascadia-code": "5.2.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "harmonyos-sans-sc-webfont-splitted": "1.1.0",
    "material-icons": "1.13.14",
    "oxlint": "^1.71.0",
    "prettier": "^3.6.2",
    "sass": "^1.101.0",
    "typescript": "~7.0.2",
    "wrangler": "^4.160.0"
  }
}
